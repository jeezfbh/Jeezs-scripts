----------------------------------------------------------------
-- UTILITY FUNCTIONS
----------------------------------------------------------------

local function formatTime(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = math.floor(seconds % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function getTotalRunSeconds()
	local total = state.elapsedBeforeThisRun
	if state.running and state.startTime then
		total += tick() - state.startTime
	end
	return total
end

local function getCoinPosition(coin)
	if coin:IsA("BasePart") then
		return coin.Position
	elseif coin:IsA("Model") then
		return coin:GetPivot().Position
	end
	return nil
end

local function getCoinsFolder()
	local folder = Workspace:FindFirstChild(CONFIG.CoinFolderName)
	if folder then return folder end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Folder") and obj.Name == CONFIG.CoinFolderName then
			return obj
		end
	end
	return nil
end

local function rescanCoins()
	local coins = {}
	local folder = getCoinsFolder()
	local searchRoot = folder or Workspace

	for _, obj in ipairs(searchRoot:GetDescendants()) do
		if (obj:IsA("BasePart") or obj:IsA("Model")) and obj.Name:find(CONFIG.CoinNamePattern) then
			if getCoinPosition(obj) then
				table.insert(coins, obj)
			end
		end
	end
	state.coinsCache = coins
	state.lastScan = tick()
end

local function getNearestCoin()
	if tick() - state.lastScan > CONFIG.CoinScanInterval then
		rescanCoins()
	end

	local now = tick()
	local nearest, nearestDist = nil, math.huge
	for _, coin in ipairs(state.coinsCache) do
		if coin and coin.Parent then
			local ignoredUntil = state.ignoredCoins[coin]
			if ignoredUntil and ignoredUntil <= now then
				state.ignoredCoins[coin] = nil -- expired, eligible again
				ignoredUntil = nil
			end
			if not ignoredUntil then
				local pos = getCoinPosition(coin)
				if pos then
					local dist = (humanoidRootPart.Position - pos).Magnitude
					if dist < nearestDist then
						nearest, nearestDist = coin, dist
					end
				end
			end
		end
	end
	return nearest
end

----------------------------------------------------------------
-- MOVEMENT ENGINE (anti-jitter, anti-bounce)
----------------------------------------------------------------

-- Anchors the HRP during the move so physics can't fight the tween (jitter),
-- keeps the character's current Y instead of snapping to the coin's exact
-- height (prevents floor-clip bounce), and zeroes leftover velocity before
-- handing control back to physics. This function only handles movement —
-- coin counting happens in farmHeartbeat, tied to the coin actually
-- disappearing from the workspace (a real pickup), not just arrival.
local function moveToCoin(coin)
	local coinPos = getCoinPosition(coin)
	if not coinPos then return end

	local keepY = humanoidRootPart.Position.Y
	local flatTarget = Vector3.new(coinPos.X, keepY, coinPos.Z)

	local distance = (humanoidRootPart.Position - flatTarget).Magnitude
	local duration = math.max(distance / state.currentSpeed, 0.05)

	local wasAnchored = humanoidRootPart.Anchored
	humanoidRootPart.Anchored = true

	local tween = TweenService:Create(
		humanoidRootPart,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ CFrame = CFrame.new(flatTarget, flatTarget + humanoidRootPart.CFrame.LookVector) }
	)

	local restored = false
	local function restorePhysics()
		if restored then return end
		restored = true
		if humanoidRootPart and humanoidRootPart.Parent then
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
			humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
			humanoidRootPart.Anchored = wasAnchored
		end
	end

	state.currentTarget = coin
	state.currentTween = tween
	state.restorePhysics = restorePhysics
	state.arrivedAt = nil

	tween.Completed:Connect(function()
		restorePhysics()
		state.arrivedAt = state.arrivedAt or tick()
	end)

	tween:Play()
end

----------------------------------------------------------------
-- MAIN FARM LOOP
----------------------------------------------------------------

local function farmHeartbeat()
	if not state.running then return end

	-- refresh character references if respawned
	if not humanoidRootPart or not humanoidRootPart.Parent then
		character = player.Character
		if character then
			humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			humanoid = character:FindFirstChild("Humanoid")
		end
		if not humanoidRootPart then return end
	end

	if humanoid and humanoid.Health <= 0 then
		return
	end

	runtimeLabel.Text = "Runtime: " .. formatTime(getTotalRunSeconds())

	local function clearTarget()
		state.currentTarget = nil
		state.currentTween = nil
		state.restorePhysics = nil
		state.arrivedAt = nil
	end

	if state.currentTarget then
		local coin = state.currentTarget

		-- Real pickup: the coin instance is actually gone. This is the only
		-- event that increments the counter, so it always matches a genuine
		-- collection rather than just "got close" or "tween finished".
		if not coin.Parent then
			if state.currentTween then state.currentTween:Cancel() end
			if state.restorePhysics then state.restorePhysics() end
			state.coinsCollected += 1
			coinsLabel.Text = "Coins: " .. state.coinsCollected
			clearTarget()
			return
		end

		-- Not yet marked "arrived" — check if we're close enough to stop
		-- moving and start waiting for the real pickup to register.
		if not state.arrivedAt then
			local pos = getCoinPosition(coin)
			if pos and (humanoidRootPart.Position - pos).Magnitude <= CONFIG.CollectionRadius then
				if state.currentTween then state.currentTween:Cancel() end
				if state.restorePhysics then state.restorePhysics() end
				state.arrivedAt = tick()
			end
		end

		-- Arrived but the coin still hasn't disappeared after a reasonable
		-- wait — something's off (wrong CollectionRadius, coin not actually
		-- reachable, etc). Give up on it, ignore it briefly, and move on
		-- instead of looping on it forever or miscounting it.
		if state.arrivedAt and (tick() - state.arrivedAt) > CONFIG.SettleTimeout then
			state.ignoredCoins[coin] = tick() + CONFIG.IgnoreDuration
			clearTarget()
		end

		return
	end

	local coin = getNearestCoin()
	if coin then
		statusLabel.Text = "Status: Farming..."
		statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
		moveToCoin(coin)
	else
		statusLabel.Text = "Status: Waiting for coins..."
		statusLabel.TextColor3 = Color3.fromRGB(220, 220, 100)
	end
end

local function startFarming()
	if state.running then return end
	state.running = true
	state.startTime = tick()

	toggleBtn.Text = "STOP FARMING"
	toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
	statusLabel.Text = "Status: Farming..."
	statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

	if not player.Character then
		player.CharacterAdded:Wait()
	end
	character = player.Character
	humanoidRootPart = character:WaitForChild("HumanoidRootPart")
	humanoid = character:WaitForChild("Humanoid")

	state.heartbeatConn = RunService.Heartbeat:Connect(farmHeartbeat)
end

local function stopFarming()
	if not state.running then return end
	state.running = false

	if state.startTime then
		state.elapsedBeforeThisRun += tick() - state.startTime
	end
	state.startTime = nil

	if state.heartbeatConn then
		state.heartbeatConn:Disconnect()
		state.heartbeatConn = nil
	end

	-- cancel any in-flight move without counting it as collected
	if state.currentTween then
		state.currentTween:Cancel()
	end
	if state.restorePhysics then
		state.restorePhysics()
	end
	state.currentTarget = nil
	state.currentTween = nil
	state.restorePhysics = nil
	state.arrivedAt = nil

	toggleBtn.Text = "START FARMING"
	toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	statusLabel.Text = "Status: Idle"
	statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

toggleBtn.MouseButton1Click:Connect(function()
	if state.running then
		stopFarming()
	else
		startFarming()
	end
end)

